    <!-- Feature previews -->

    <string name="feature_nutrition_title">Food and nutrition</string>
    <string name="feature_nutrition_summary">Food diary with common Indonesian meals and estimated calories.</string>
    <string name="feature_nutrition_description">Log meals with a starter database of Indonesian foods. Nutrition values are estimates because recipes and portions vary.</string>
    <string name="feature_nutrition_planned_1">Food diary for breakfast, lunch, dinner and snacks</string>
    <string name="feature_nutrition_planned_2">Indonesian foods, custom foods and favourites</string>
