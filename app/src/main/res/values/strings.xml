    <string name="onboarding_body_title">About you</string>
    <string name="onboarding_body_description">All fields are optional. Your weight helps suggest a water target; later phases use these values for calorie estimates. Data stays on this device.</string>
    <string name="onboarding_experience_title">Experience and activity</string>
    <string name="onboarding_experience_description">This helps set a step goal you can actually reach. Tap a selected option again to clear it.</string>
    <string name="onboarding_preferences_title">Workout and food preferences</string>
    <string name="onboarding_preferences_description">Used later to suggest workouts and recipes that fit you. You can change these anytime.</string>
    <string name="onboarding_goals_title">Your daily goals</string>
    <string name="onboarding_goals_description">Suggested starting points based on your answers. Adjust them freely; you can change them later in your profile.</string>

