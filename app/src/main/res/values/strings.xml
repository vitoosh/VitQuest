    <string name="feature_workouts_planned_2">Workout generator based on time, level and equipment</string>
    <string name="feature_workouts_planned_3">Guided player with rest timers and history</string>

    <string name="feature_rewards_title">XP and rewards</string>
    <string name="feature_rewards_summary">Earn XP and Reward Credits for consistency.</string>
    <string name="feature_rewards_description">Earn XP and in-app Reward Credits for healthy habits and spend them on rewards you define. Credits are virtual and never real money.</string>
    <string name="feature_rewards_planned_1">Levels with transparent earning rules</string>
    <string name="feature_rewards_planned_2">Reward catalogue, wishlist and redemption history</string>
    <string name="feature_rewards_planned_3">Separate tracker for your real-world savings budget</string>

