    <!-- Feature previews -->
    <string name="feature_activity_title">Steps and activity</string>
    <string name="feature_activity_summary">Daily steps from Health Connect, phone sensor or manual entry.</string>
    <string name="feature_activity_description">Track daily steps and activity with clear labels showing where each number comes from.</string>
    <string name="feature_activity_planned_1">Health Connect with clear permission explanations</string>
    <string name="feature_activity_planned_2">Phone step sensor and manual entry as fallbacks</string>
    <string name="feature_activity_planned_3">Daily and weekly progress toward your step goal</string>

    <string name="feature_nutrition_title">Food and nutrition</string>
    <string name="feature_nutrition_summary">Food diary with common Indonesian meals and estimated calories.</string>
    <string name="feature_nutrition_description">Log meals with a starter database of Indonesian foods. Nutrition values are estimates because recipes and portions vary.</string>
    <string name="feature_nutrition_planned_1">Food diary for breakfast, lunch, dinner and snacks</string>
    <string name="feature_nutrition_planned_2">Indonesian foods, custom foods and favourites</string>
    <string name="feature_nutrition_planned_3">Recipes, meal plans and shopping lists</string>

    <string name="feature_hydration_title">Hydration</string>
    <string name="feature_hydration_summary">Quick water logging and optional reminders.</string>

    <string name="feature_workouts_title">Workouts</string>
    <string name="feature_workouts_summary">Short no-gym calisthenics sessions for any level.</string>
    <string name="feature_workouts_description">Bodyweight workouts of 5 to 30 minutes for home, office or outdoors, with beginner modifications.</string>
    <string name="feature_workouts_planned_1">Exercise library with instructions and safety notes</string>
    <string name="feature_workouts_planned_2">Workout generator based on time, level and equipment</string>
    <string name="feature_workouts_planned_3">Guided player with rest timers and history</string>

    <string name="feature_rewards_title">XP and rewards</string>
    <string name="feature_rewards_summary">Earn XP and Reward Credits for consistency.</string>
    <string name="feature_rewards_description">Earn XP and in-app Reward Credits for healthy habits and spend them on rewards you define. Credits are virtual and never real money.</string>
    <string name="feature_rewards_planned_1">Levels with transparent earning rules</string>
    <string name="feature_rewards_planned_2">Reward catalogue, wishlist and redemption history</string>
    <string name="feature_rewards_planned_3">Separate tracker for your real-world savings budget</string>

