    <string name="onboarding_welcome_point_move_description">Steps, short calisthenics sessions and movement breaks.</string>
    <string name="onboarding_welcome_point_eat_title">Eat and drink mindfully</string>
    <string name="onboarding_welcome_point_eat_description">Food diary with Indonesian meals, recipes and hydration.</string>
    <string name="onboarding_welcome_point_reward_title">Stay motivated</string>
    <string name="onboarding_welcome_point_reward_description">XP, levels and rewards you define yourself.</string>
    <string name="onboarding_disclaimer">VitQuest is not a medical device. Goals and calorie numbers are estimates. Talk to a health professional before making major changes to your diet or exercise.</string>
